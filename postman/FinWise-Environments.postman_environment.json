{
  "id": "finwise-environments",
  "name": "FinWise – Environments (Local / Staging / Production)",
  "_postman_variable_scope": "environment",
  "info": {
    "_postman_id": "finwise-env-001",
    "name": "FinWise – Environments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "environments": [
    {
      "id": "finwise-local",
      "name": "FinWise – Local",
      "values": [
        {
          "key": "baseUrl",
          "value": "http://127.0.0.1:5000",
          "type": "default",
          "enabled": true
        },
        {
          "key": "accessToken",
          "value": "",
          "type": "secret",
          "enabled": true
        },
        {
          "key": "applicationId",
          "value": "1",
          "type": "default",
          "enabled": true
        },
        {
          "key": "username",
          "value": "admin",
          "type": "default",
          "enabled": true
        },
        {
          "key": "password",
          "value": "admin123",
          "type": "secret",
          "enabled": true
        },
        {
          "key": "aiProvider",
          "value": "",
          "type": "default",
          "enabled": true,
          "_description": "Leave empty for deterministic mode. Set to 'openai' or 'anthropic' to enable LLM."
        }
      ]
    },
    {
      "id": "finwise-staging",
      "name": "FinWise – Staging",
      "values": [
        {
          "key": "baseUrl",
          "value": "https://staging.finwise-api.example.com",
          "type": "default",
          "enabled": true
        },
        {
          "key": "accessToken",
          "value": "",
          "type": "secret",
          "enabled": true
        },
        {
          "key": "applicationId",
          "value": "1",
          "type": "default",
          "enabled": true
        },
        {
          "key": "username",
          "value": "staging_admin",
          "type": "default",
          "enabled": true
        },
        {
          "key": "password",
          "value": "",
          "type": "secret",
          "enabled": true
        },
        {
          "key": "aiProvider",
          "value": "openai",
          "type": "default",
          "enabled": true
        }
      ]
    },
    {
      "id": "finwise-production",
      "name": "FinWise – Production",
      "values": [
        {
          "key": "baseUrl",
          "value": "https://api.finwise.example.com",
          "type": "default",
          "enabled": true
        },
        {
          "key": "accessToken",
          "value": "",
          "type": "secret",
          "enabled": true
        },
        {
          "key": "applicationId",
          "value": "",
          "type": "default",
          "enabled": true,
          "_description": "Set to a real application ID from the production database."
        },
        {
          "key": "username",
          "value": "",
          "type": "default",
          "enabled": true
        },
        {
          "key": "password",
          "value": "",
          "type": "secret",
          "enabled": true
        },
        {
          "key": "aiProvider",
          "value": "anthropic",
          "type": "default",
          "enabled": true
        }
      ]
    }
  ]
}
