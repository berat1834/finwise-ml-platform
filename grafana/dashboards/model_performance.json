{
  "title": "Model Performance",
  "uid": "model_perf_1",
  "refresh": "30s",
  "panels": [
    {
      "title": "Model Accuracy over Time",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "model_accuracy",
          "refId": "A"
        }
      ],
      "datasource": "${datasource}"
    },
    {
      "title": "AUC-ROC Trend",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "model_auc_roc",
          "refId": "A"
        }
      ],
      "datasource": "${datasource}"
    },
    {
      "title": "Precision & Recall",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "model_precision",
          "refId": "A"
        },
        {
          "expr": "model_recall",
          "refId": "B"
        }
      ],
      "datasource": "${datasource}"
    },
    {
      "title": "Prediction Latency (P95/P99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(model_prediction_latency_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(model_prediction_latency_seconds_bucket[5m])) by (le))",
          "refId": "B",
          "legendFormat": "P99"
        }
      ],
      "datasource": "${datasource}"
    },
    {
      "title": "PSI Drift Metric",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "model_dataset_drift",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        }
      },
      "datasource": "${datasource}"
    },
    {
      "title": "KS-Test Metric",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "model_ks_test",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        }
      },
      "datasource": "${datasource}"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "value": "default"
        }
      }
    ]
  }
}
