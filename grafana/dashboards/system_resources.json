{
  "title": "System Resources",
  "uid": "system_resources_1",
  "refresh": "30s",
  "panels": [
    {
      "title": "CPU Usage %",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "system_cpu_usage_percent",
          "refId": "A"
        }
      ],
      "datasource": "${datasource}"
    },
    {
      "title": "Memory Usage %",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "system_memory_usage_percent",
          "refId": "A"
        }
      ],
      "datasource": "${datasource}"
    },
    {
      "title": "Disk Usage %",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "system_disk_usage_percent",
          "refId": "A"
        }
      ],
      "datasource": "${datasource}"
    },
    {
      "title": "PostgreSQL Active Connections",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "refId": "A"
        }
      ],
      "datasource": "${datasource}"
    },
    {
      "title": "Redis Memory Usage",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "refId": "A"
        }
      ],
      "datasource": "${datasource}"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "value": "default"
        }
      }
    ]
  }
}
