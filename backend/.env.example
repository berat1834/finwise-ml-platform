# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour in seconds

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/credit_risk_db

# Rate Limiting
RATE_LIMIT_STORAGE_URL=memory://

# Model Configuration
MODEL_PATH=model.joblib
MODEL_META_PATH=model_meta.json

# Model Routing (safe rollout)
MODEL_ROUTING_MODE=single  # single|shadow|canary
CANARY_PERCENT=0  # 0-100, only used when MODEL_ROUTING_MODE=canary
CANARY_MODEL_PATH=model_production_fair.joblib
CANARY_MODEL_META_PATH=model_production_fair_meta.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=2097152  # 2MB
LOG_BACKUP_COUNT=3

# Security
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500
MAX_CONTENT_LENGTH=1048576  # 1MB max request size
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'
ENFORCE_STRONG_SECRETS=false
ALLOW_PUBLIC_REGISTRATION=false
REGISTRATION_MODE=closed  # closed|invite_only|domain_restricted|public
REGISTRATION_INVITE_CODE=
REGISTRATION_ALLOWED_EMAIL_DOMAINS=
ALLOW_DEMO_ADMIN_LOGIN=true  # dev-only fallback for admin/admin123 (ignored in production)

# Auth hardening
AUTH_FAILURE_WINDOW_SEC=900
AUTH_MAX_FAILURES=5
AUTH_BLOCK_SECONDS=600
ENFORCE_JSON_REQUESTS=true

# Database pooling
DB_POOL_RECYCLE_SEC=1800

# Monitoring
ENABLE_METRICS=true
ENABLE_PROFILING=false

# AI Risk Assistant (optional LLM mode)
# Leave AI_ASSISTANT_PROVIDER empty to use deterministic local mode.
# Supported providers: openai, anthropic
AI_ASSISTANT_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Bank Partner API Endpoints (Offer Adapter Layer) ---
# Leave blank to use deterministic mock fallback offers.
# Each adapter reads its URL from the corresponding env var.
BANK_API_ALFA_URL=
BANK_API_NOVA_URL=
BANK_API_HORIZON_URL=

# Adapter request timeout (seconds) and max retries on 5xx
BANK_API_TIMEOUT_SEC=2.0
BANK_API_RETRIES=1

# --- Offer Event Rate Limiting ---
# Maximum offer events per user per window; set to 0 to disable
OFFERS_EVENT_RATE_LIMIT_PER_MIN=60
OFFERS_EVENT_RATE_WINDOW_SEC=60

# --- A/B Testing (Offer Ranking) ---
# Percentage of users (0-100) assigned to variant B (confidence-score-first ranking).
# Set to 0 to disable A/B test (all users get variant A).
OFFERS_AB_SPLIT_PERCENT=50
